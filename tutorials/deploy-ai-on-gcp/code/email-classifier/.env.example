# Copy to .env for local development.
# In production, these are set via Cloud Run Job env vars (see terraform/main.tf).

GCP_PROJECT=your-project-id
GCP_REGION=europe-west1
GMAIL_OAUTH_SECRET=gmail-oauth-token
# Choose a currently supported model from Vertex AI Model Garden.
GEMINI_MODEL=replace-with-current-model-id

# Local-only flags
DRY_RUN=true
LIMIT=5
