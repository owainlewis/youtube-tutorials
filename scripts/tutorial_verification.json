{
  "tutorials": {
    "6-types-of-rag": {
      "kind": "offline",
      "commands": [
        {
          "name": "six retrieval strategy tests",
          "cwd": "tutorials/6-types-of-rag/code",
          "run": [
            "python3",
            "-m",
            "unittest",
            "discover",
            "-s",
            "tests",
            "-v"
          ]
        }
      ]
    },
    "ai-agent-memory": {
      "kind": "offline",
      "commands": [
        {
          "cwd": "tutorials/ai-agent-memory/code",
          "run": ["python", "-m", "unittest", "discover", "-s", "tests", "-v"]
        }
      ]
    },
    "ai-code-review": {
      "kind": "offline",
      "commands": [
        {
          "cwd": "tutorials/ai-code-review",
          "run": ["python", "code/verify_templates.py"]
        }
      ]
    },
    "deploy-ai-on-gcp": {
      "kind": "offline",
      "commands": [
        {
          "cwd": "tutorials/deploy-ai-on-gcp/code/email-classifier",
          "run": ["python", "-m", "unittest", "discover", "-s", "tests", "-v"]
        }
      ]
    },
    "docker-sandboxes-for-developers": {
      "kind": "offline",
      "commands": [
        {
          "cwd": "tutorials/docker-sandboxes-for-developers/code",
          "run": ["python", "-m", "unittest", "discover", "-v"]
        }
      ]
    },
    "herdr-agent-workflow": {
      "kind": "static",
      "commands": [
        {
          "cwd": "tutorials/herdr-agent-workflow",
          "run": ["bash", "-n", "code/setup-herdr.sh"]
        }
      ]
    },
    "intent-based-classification": {
      "kind": "offline",
      "commands": [
        {
          "cwd": "tutorials/intent-based-classification/code",
          "run": ["python", "-m", "unittest", "-v", "test_offline.py"]
        }
      ]
    },
    "micro-agents-demo": {
      "kind": "offline",
      "commands": [
        {
          "name": "YouTube tool unit tests",
          "cwd": "tutorials/micro-agents-demo/code",
          "run": ["bash", "tests/run.sh"]
        }
      ]
    },
    "micro-neo": {
      "kind": "offline",
      "commands": [
        {
          "cwd": "tutorials/micro-neo/code",
          "run": ["go", "test", "./..."]
        },
        {
          "cwd": "tutorials/micro-neo/code",
          "run": ["go", "vet", "./..."]
        }
      ]
    },
    "nano-agent": {
      "kind": "offline",
      "commands": [
        {
          "cwd": "tutorials/nano-agent/code",
          "env": {"PYTHONPATH": "src"},
          "run": [
            "uv",
            "run",
            "--no-project",
            "--with",
            "pytest",
            "--with",
            "anthropic",
            "--with",
            "pyyaml",
            "--with",
            "rich",
            "pytest"
          ]
        }
      ]
    },
    "pi-agent-workflow": {
      "kind": "offline",
      "commands": [
        {
          "name": "nano harness unit tests",
          "cwd": "tutorials/pi-agent-workflow/code",
          "run": [
            "python3",
            "-m",
            "unittest",
            "discover",
            "-s",
            "tests",
            "-v"
          ]
        }
      ]
    },
    "pi-coding-agent-guide": {
      "kind": "static",
      "commands": [
        {
          "name": "Pi resource checks",
          "cwd": "tutorials/pi-coding-agent-guide",
          "run": ["node", "code/verify.mjs"]
        }
      ]
    },
    "postgresql-only-database-ai": {
      "kind": "offline",
      "commands": [
        {
          "name": "PostgreSQL RAG static verification",
          "cwd": "tutorials/postgresql-only-database-ai/code",
          "run": ["python3", "verify_offline.py"]
        }
      ]
    },
    "testing-ai-generated-code": {
      "kind": "offline",
      "commands": [
        {
          "name": "session policy unit tests",
          "cwd": "tutorials/testing-ai-generated-code/code",
          "run": [
            "python3",
            "-m",
            "unittest",
            "discover",
            "-s",
            "tests",
            "-v"
          ]
        }
      ]
    }
  }
}
